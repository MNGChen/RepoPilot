# Copy this file to .env and add your own API key before running the agent.
OPENAI_API_KEY=your_openai_api_key_here

# Used in a later step, when we connect DevPilot to the LLM.
OPENAI_MODEL=gpt-5.4-mini

# Used by V2's ingestion script to turn repository chunks into vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# V5: create a fine-grained GitHub PAT with the smallest read-only repository
# permissions you need. Never commit the real token.
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here
